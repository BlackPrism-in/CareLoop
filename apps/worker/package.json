{
  "name": "@careloop/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@careloop/adapters": "workspace:*",
    "@careloop/ai": "workspace:*",
    "@careloop/contracts": "workspace:*",
    "@careloop/domain": "workspace:*",
    "@careloop/observability": "workspace:*",
    "@hono/node-server": "2.1.9",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  },
  "scripts": {
    "dev": "PORT=8081 tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  }
}
