{
  "name": "@careloop/voice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@careloop/adapters": "workspace:*",
    "@careloop/ai": "workspace:*",
    "@careloop/contracts": "workspace:*",
    "@careloop/domain": "workspace:*",
    "@careloop/jobs": "workspace:*",
    "@careloop/observability": "workspace:*",
    "@google/genai": "3.6.1",
    "firebase-admin": "14.5.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  },
  "scripts": {
    "dev": "PORT=8082 tsx --env-file-if-exists=../../.env.local src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev:watch": "PORT=8082 tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-careloop-voice --config ../../firebase.json \"vitest run --config vitest.emulator.config.ts\""
  },
  "exports": {
    "./controller": "./src/controller.ts",
    "./live": "./src/live.ts"
  }
}
