    "@careloop/jobs": "workspace:*",
    "@careloop/observability": "workspace:*",
    "@next/env": "16.4.6",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "unpdf": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
