{
  "name": "careloop",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start --only firestore,auth",
    "seed": "pnpm --filter @careloop/scripts seed",
    "check:models": "corepack pnpm --filter @careloop/scripts check-models",
    "eval:models": "python models/eval.py",
    "dev:models-api": "python models/intake_app.py",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "test:emulator": "pnpm --filter @careloop/domain test:emulator"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
