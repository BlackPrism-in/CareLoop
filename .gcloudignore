# Cloud Build upload (infra/cloudbuild.yaml). Mirrors .dockerignore; never uploads secrets.
.git
**/node_modules
**/.next
**/dist
**/*.log
.env
.env.*
!.env.example
infra/.terraform
infra/**/*.tfvars
infra/*.tfstate*
evals/reports
emulator-data
**/.DS_Store
# The Flutter app and documents are not part of the server images.
apps/patient_app
docs/*.pdf
**/firebase-debug.log
