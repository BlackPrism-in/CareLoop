# Copy to .env.local for local development. Never commit real values.
# Secrets (GEMINI_API_KEY, provider keys) live in Secret Manager in deployed envs.

APP_ENV=local
APP_REGION=asia-south1
SITE_TIMEZONE=Asia/Kolkata
GOOGLE_CLOUD_PROJECT=demo-careloop

# One contracted API surface: vertex (service account, recommended) | gemini-developer (API key)
GOOGLE_API_SURFACE=vertex
# Text models: 3.8 Flash is not offered in asia-south1, so use global.
GOOGLE_CLOUD_LOCATION=global
# Live model: only us / eu / us-central1. Audio is processed outside India (see docs/GCP_SETUP.md).
LIVE_MODEL_LOCATION=us-central1
# GEMINI_API_KEY=            # only for gemini-developer; local use only

# Model IDs — names checked against Google's model pages on 20 Nov 2026 (all listed as stable).
# Still run `pnpm check:models` to confirm your project can reach them.
INTAKE_MODEL_ID=gemini-3.5-flash-lite
COORDINATION_MODEL_ID=gemini-3.8-flash
VERIFICATION_MODEL_ID=gemini-3.8-flash
LIVE_MODEL_ID=gemini-3.8-live

BOOKING_ADAPTER=sandbox
VOICE_ADAPTER=browser
MESSAGING_ADAPTER=simulated
OUTREACH_ENABLED=false
MAX_CONTACT_ATTEMPTS=2
MAX_CASE_AUDIO_SECONDS=180
CLOUD_TASKS_QUEUE=careloop-jobs

# Local emulators (pnpm emulators)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
